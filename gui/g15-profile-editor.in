#!/usr/bin/env python3
"""GTK 4 profile editor for the first-generation Logitech G15."""

from __future__ import annotations

import sys
from copy import deepcopy
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gio, GLib, Gtk

SOURCE_DIR = Path(__file__).resolve().parent
INSTALLED_MODULE_DIR = Path("@G15_GUI_MODULE_DIR@")
sys.path.insert(0, str(SOURCE_DIR if (SOURCE_DIR / "g15_profile.py").exists()
                       else INSTALLED_MODULE_DIR))

import g15_keyd
import g15_platform
from g15_profile import ActionKind, BindingAction, PROFILE_NAMES, ProfileSet

CONFIG_PATH = g15_platform.user_config_path()
HELPER_PATH = Path("@G15_PROFILE_HELPER@")
ACTION_KINDS = (
    (ActionKind.DISABLED, "Deaktiviert"),
    (ActionKind.KEYSTROKE, "Einzeltaste oder Tastenkombination"),
    (ActionKind.MACRO, "Tastenfolge / Makro"),
    (ActionKind.REPEATING_MACRO, "Makro wiederholen, solange gedrückt"),
    (ActionKind.ADVANCED, "Erweiterter keyd-Ausdruck"),
)


def binding_summary(binding: str) -> str:
    action = BindingAction.parse(binding)
    labels = {
        ActionKind.DISABLED: "Nicht belegt",
        ActionKind.KEYSTROKE: action.value,
        ActionKind.MACRO: f"Makro: {action.value}",
        ActionKind.REPEATING_MACRO: f"Wiederholen: {action.value}",
        ActionKind.ADVANCED: f"Erweitert: {action.value}",
    }
    text = labels[action.kind]
    return text if len(text) <= 25 else text[:22] + "…"


class ActionDialog(Gtk.Window):
    """Edit one G-key binding without leaking GTK details into the model."""

    def __init__(self, parent: Gtk.Window, profile: str, number: int, binding: str,
                 on_apply):
        super().__init__(title=f"{profile.upper()} · G{number} belegen",
                         transient_for=parent, modal=True)
        self.set_default_size(560, -1)
        self.on_apply = on_apply

        action = BindingAction.parse(binding)
        area = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.set_child(area)
        area.set_spacing(12)
        area.set_margin_top(16); area.set_margin_bottom(16)
        area.set_margin_start(16); area.set_margin_end(16)

        grid = Gtk.Grid(column_spacing=12, row_spacing=10)
        area.append(grid)
        grid.attach(Gtk.Label(label="Aktionstyp", xalign=0), 0, 0, 1, 1)
        self.kind = Gtk.DropDown.new_from_strings([label for _kind, label in ACTION_KINDS])
        self.kind.set_selected(next(index for index, item in enumerate(ACTION_KINDS)
                                    if item[0] == action.kind))
        grid.attach(self.kind, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Tasten / Ausdruck", xalign=0), 0, 1, 1, 1)
        self.value = Gtk.Entry(text=action.value, hexpand=True)
        self.value.set_placeholder_text("z. B. C-c oder C-t 100ms example.com enter")
        grid.attach(self.value, 1, 1, 1, 1)

        grid.attach(Gtk.Label(label="Startverzögerung", xalign=0), 0, 2, 1, 1)
        self.initial_delay = Gtk.SpinButton.new_with_range(1, 9999, 10)
        self.initial_delay.set_value(action.initial_delay)
        self.initial_delay.set_tooltip_text("Millisekunden bis zur ersten Wiederholung")
        grid.attach(self.initial_delay, 1, 2, 1, 1)

        grid.attach(Gtk.Label(label="Wiederholabstand", xalign=0), 0, 3, 1, 1)
        self.repeat_delay = Gtk.SpinButton.new_with_range(1, 9999, 10)
        self.repeat_delay.set_value(action.repeat_delay)
        self.repeat_delay.set_tooltip_text("Millisekunden zwischen Wiederholungen")
        grid.attach(self.repeat_delay, 1, 3, 1, 1)

        self.help = Gtk.Label(xalign=0, wrap=True)
        self.help.add_css_class("dim-label")
        area.append(self.help)
        self.error = Gtk.Label(xalign=0, wrap=True)
        self.error.add_css_class("error")
        area.append(self.error)
        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                          halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Abbrechen")
        cancel.connect("clicked", lambda _button: self.destroy())
        buttons.append(cancel)
        apply = Gtk.Button(label="Übernehmen")
        apply.add_css_class("suggested-action")
        apply.connect("clicked", self.apply)
        buttons.append(apply)
        area.append(buttons)
        self.kind.connect("notify::selected", self.on_kind_changed)
        self.on_kind_changed()

    def selected_kind(self) -> ActionKind:
        return ACTION_KINDS[self.kind.get_selected()][0]

    def on_kind_changed(self, *_args) -> None:
        kind = self.selected_kind()
        needs_value = kind != ActionKind.DISABLED
        repeats = kind == ActionKind.REPEATING_MACRO
        self.value.set_sensitive(needs_value)
        self.initial_delay.set_sensitive(repeats)
        self.repeat_delay.set_sensitive(repeats)
        help_text = {
            ActionKind.DISABLED: "Die G-Taste löst keine Aktion aus.",
            ActionKind.KEYSTROKE: "keyd-Schreibweise, z. B. f5, C-c, C-A-t oder M-S-s.",
            ActionKind.MACRO: "Tasten durch Leerzeichen trennen. Verzögerungen wie 100ms sind möglich.",
            ActionKind.REPEATING_MACRO: "Wie in der Logitech-Software: Wiederholung läuft nur während die G-Taste gehalten wird.",
            ActionKind.ADVANCED: "Unveränderter keyd-Ausdruck für erfahrene Benutzer. Keine Shell-Befehle als root verwenden.",
        }
        self.help.set_text(help_text[kind])

    def binding(self) -> str:
        return BindingAction(
            self.selected_kind(), self.value.get_text(),
            self.initial_delay.get_value_as_int(),
            self.repeat_delay.get_value_as_int(),
        ).render()

    def apply(self, _button: Gtk.Button) -> None:
        try:
            self.on_apply(self.binding())
            self.destroy()
        except ValueError as error:
            self.error.set_text(f"Fehler: {error}")


class ProfileWindow(Gtk.ApplicationWindow):
    def __init__(self, application: Gtk.Application):
        super().__init__(application=application, title="G15 Profile Editor")
        self.set_default_size(900, 720)
        self.model = ProfileSet()
        self.key_buttons: dict[str, list[Gtk.Button]] = {
            name: [] for name in PROFILE_NAMES
        }
        self.file_dialog = None

        header = Gtk.HeaderBar()
        self.set_titlebar(header)
        for label, callback in (("Neu", self.on_new), ("Importieren", self.on_import),
                                ("Exportieren", self.on_export)):
            button = Gtk.Button(label=label)
            button.connect("clicked", callback)
            header.pack_start(button)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(16); root.set_margin_bottom(16)
        root.set_margin_start(16); root.set_margin_end(16)
        self.set_child(root)

        settings = Gtk.Grid(column_spacing=12, row_spacing=8)
        settings.attach(Gtk.Label(label="Aktuelles Profil", xalign=0), 0, 0, 1, 1)
        self.profile_name = Gtk.Entry(hexpand=True)
        settings.attach(self.profile_name, 1, 0, 1, 1)
        settings.attach(Gtk.Label(label="UINPUT-Geräte-ID", xalign=0), 0, 1, 1, 1)
        self.device_id = Gtk.Entry(hexpand=True)
        settings.attach(self.device_id, 1, 1, 1, 1)
        settings.attach(Gtk.Label(label="Starthelligkeit", xalign=0), 0, 2, 1, 1)
        self.brightness = Gtk.DropDown.new_from_strings(
            ["0 – aus", "1 – mittel", "2 – maximal"])
        settings.attach(self.brightness, 1, 2, 1, 1)
        root.append(settings)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               vexpand=True)
        switcher = Gtk.StackSwitcher(stack=self.stack, halign=Gtk.Align.CENTER)
        root.append(switcher)
        for profile in PROFILE_NAMES:
            self.stack.add_titled(self.build_bank(profile), profile, profile.upper())
        root.append(self.stack)

        root.append(Gtk.Label(
            label="MR bleibt für die spätere Schnellaufnahme reserviert. "
                  "LCD-Tasten und der runde Applet-Knopf werden nicht verändert.",
            xalign=0, wrap=True))
        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                          halign=Gtk.Align.END)
        for label, callback in (("Prüfen", self.on_validate),
                                ("Speichern", self.on_save),
                                ("Systemweit übernehmen …", self.on_apply)):
            button = Gtk.Button(label=label)
            button.connect("clicked", callback)
            if label == "Speichern":
                button.add_css_class("suggested-action")
            buttons.append(button)
        root.append(buttons)
        self.status = Gtk.Label(xalign=0, wrap=True, selectable=True)
        root.append(self.status)

        self.load_initial_model()

    def build_bank(self, profile: str) -> Gtk.Widget:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.set_margin_top(8)
        grid = Gtk.Grid(column_spacing=12, row_spacing=10,
                        column_homogeneous=True, row_homogeneous=True,
                        hexpand=True, vexpand=True)
        for index in range(18):
            number = index + 1
            button = Gtk.Button()
            button.set_hexpand(True); button.set_vexpand(True)
            button.connect("clicked", self.on_edit_binding, profile, index)
            grid.attach(button, index // 6, index % 6, 1, 1)
            self.key_buttons[profile].append(button)
        page.append(grid)

        tools = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                        halign=Gtk.Align.CENTER)
        for target in PROFILE_NAMES:
            if target != profile:
                button = Gtk.Button(label=f"Nach {target.upper()} kopieren")
                button.connect("clicked", self.on_copy_bank, profile, target)
                tools.append(button)
        disable = Gtk.Button(label="Alle deaktivieren")
        disable.connect("clicked", self.on_reset_bank, profile, False)
        tools.append(disable)
        defaults = Gtk.Button(label="Windows-Standard")
        defaults.connect("clicked", self.on_reset_bank, profile, True)
        tools.append(defaults)
        page.append(tools)
        return page

    def load_initial_model(self) -> None:
        try:
            model = g15_keyd.load(CONFIG_PATH) if CONFIG_PATH.exists() else ProfileSet()
            self.load_model(model)
            if CONFIG_PATH.exists():
                self.status.set_text(f"Geladen: {CONFIG_PATH}")
        except (OSError, ValueError, KeyError) as error:
            self.load_model(ProfileSet())
            self.status.set_text(f"Vorhandenes Profil konnte nicht geladen werden: {error}")

    def load_model(self, model: ProfileSet) -> None:
        self.model = deepcopy(model)
        self.profile_name.set_text(model.name)
        self.device_id.set_text(model.device_id)
        self.brightness.set_selected(model.brightness)
        self.refresh_buttons()

    def collect(self) -> ProfileSet:
        model = ProfileSet(
            name=self.profile_name.get_text().strip(),
            device_id=self.device_id.get_text().strip(),
            brightness=int(self.brightness.get_selected()),
            bindings=deepcopy(self.model.bindings),
        )
        model.validate()
        return model

    def refresh_buttons(self, profile: str | None = None) -> None:
        profiles = (profile,) if profile else PROFILE_NAMES
        for name in profiles:
            for index, button in enumerate(self.key_buttons[name]):
                summary = binding_summary(self.model.bindings[name][index])
                button.set_label(f"G{index + 1}\n{summary}")
                button.set_tooltip_text(self.model.bindings[name][index])

    def on_edit_binding(self, _button: Gtk.Button, profile: str, index: int) -> None:
        def apply(binding: str) -> None:
            self.model.bindings[profile][index] = binding
            self.refresh_buttons(profile)
            self.status.set_text(f"{profile.upper()} · G{index + 1} geändert.")

        dialog = ActionDialog(self, profile, index + 1,
                              self.model.bindings[profile][index], apply)
        dialog.present()

    def on_copy_bank(self, _button: Gtk.Button, source: str, target: str) -> None:
        self.model.copy_bank(source, target)
        self.refresh_buttons(target)
        self.status.set_text(f"{source.upper()} wurde nach {target.upper()} kopiert.")

    def on_reset_bank(self, _button: Gtk.Button, profile: str, defaults: bool) -> None:
        self.model.reset_bank(profile, use_windows_defaults=defaults)
        self.refresh_buttons(profile)
        text = "Windows-Standardbelegung" if defaults else "deaktivierte Belegung"
        self.status.set_text(f"{profile.upper()} verwendet jetzt die {text}.")

    def execute(self, save: bool) -> ProfileSet | None:
        try:
            model = self.collect()
            g15_keyd.validate(model, g15_platform.find_tool("G15_KEYD", "keyd"))
            if save:
                g15_keyd.save(model, CONFIG_PATH)
                self.model = deepcopy(model)
            self.status.set_text("Konfiguration ist gültig." if not save else
                                 f"Gespeichert und geprüft: {CONFIG_PATH}")
            return model
        except (OSError, ValueError) as error:
            self.status.set_text(f"Fehler: {error}")
            return None

    def on_new(self, _button: Gtk.Button) -> None:
        self.load_model(ProfileSet())
        self.status.set_text("Neues, noch nicht gespeichertes Profil.")

    def choose_file(self, title: str, action: Gtk.FileChooserAction,
                    callback, suggested_name: str | None = None) -> None:
        accept = "Öffnen" if action == Gtk.FileChooserAction.OPEN else "Exportieren"
        chooser = Gtk.FileChooserNative.new(title, self, action, accept, "Abbrechen")
        file_filter = Gtk.FileFilter()
        file_filter.set_name("G15-/keyd-Profile (*.conf)")
        file_filter.add_pattern("*.conf")
        chooser.add_filter(file_filter)
        if suggested_name:
            chooser.set_current_name(suggested_name)
        chooser.connect("response", callback)
        self.file_dialog = chooser
        chooser.show()

    def on_import(self, _button: Gtk.Button) -> None:
        self.choose_file("G15-Profil importieren", Gtk.FileChooserAction.OPEN,
                         self.on_import_selected)

    def on_import_selected(self, chooser: Gtk.FileChooserNative, response: int) -> None:
        try:
            if response == Gtk.ResponseType.ACCEPT:
                path = g15_platform.local_file_path(chooser.get_file())
                self.load_model(g15_keyd.load(path))
                self.status.set_text(f"Importiert: {path}")
        except (OSError, ValueError, KeyError) as error:
            self.status.set_text(f"Import fehlgeschlagen: {error}")
        finally:
            chooser.destroy()
            self.file_dialog = None

    def on_export(self, _button: Gtk.Button) -> None:
        safe_name = g15_platform.safe_profile_filename(self.profile_name.get_text())
        self.choose_file("G15-Profil exportieren", Gtk.FileChooserAction.SAVE,
                         self.on_export_selected, safe_name)

    def on_export_selected(self, chooser: Gtk.FileChooserNative, response: int) -> None:
        try:
            if response == Gtk.ResponseType.ACCEPT:
                model = self.collect()
                g15_keyd.validate(model, g15_platform.find_tool("G15_KEYD", "keyd"))
                path = g15_platform.local_file_path(chooser.get_file())
                g15_keyd.save(model, path)
                self.status.set_text(f"Exportiert: {path}")
        except (OSError, ValueError) as error:
            self.status.set_text(f"Export fehlgeschlagen: {error}")
        finally:
            chooser.destroy()
            self.file_dialog = None

    def on_validate(self, _button: Gtk.Button) -> None:
        self.execute(save=False)

    def on_save(self, _button: Gtk.Button) -> None:
        self.execute(save=True)

    def on_apply(self, _button: Gtk.Button) -> None:
        model = self.execute(save=True)
        if model is None:
            return
        helper = HELPER_PATH if HELPER_PATH.exists() else SOURCE_DIR / "g15-profile-install"
        try:
            command = g15_platform.system_apply_command(helper, CONFIG_PATH, model.brightness)
            process = Gio.Subprocess.new(
                command, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
            process.communicate_utf8_async(None, None, self.on_apply_finished)
            self.status.set_text("Systemweite Übernahme läuft …")
        except (GLib.Error, OSError) as error:
            message = error.message if isinstance(error, GLib.Error) else str(error)
            self.status.set_text(f"Übernahme konnte nicht gestartet werden: {message}")

    def on_apply_finished(self, process: Gio.Subprocess, result) -> None:
        try:
            _successful, output, _error_output = process.communicate_utf8_finish(result)
            self.status.set_text(output.strip() if process.get_successful()
                                 else f"Übernahme fehlgeschlagen: {output.strip()}")
        except GLib.Error as error:
            self.status.set_text(f"Übernahme fehlgeschlagen: {error.message}")


class ProfileApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.it_nwd.G15ProfileEditor")

    def do_activate(self):
        window = self.props.active_window or ProfileWindow(self)
        window.present()


raise SystemExit(ProfileApplication().run(sys.argv))
